# @babel/core-8 / @babel/preset-react-8 (see package.json devDependencies) are
# npm aliases for the real Babel 8 packages, installed alongside the Babel 7
# versions the rest of the suite uses so tests can run against both majors.
# Those Babel 8 packages declare a peer dependency on the real (unaliased)
# "@babel/core" name, which conflicts with the Babel 7 @babel/core already in
# the tree. legacy-peer-deps disables npm's peer dependency resolution
# entirely so both can coexist.
legacy-peer-deps=true
